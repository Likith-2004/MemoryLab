# syntax=docker/dockerfile:1
# Sandbox image: runs ONE agent run. No shell tools beyond the base image, no secrets baked in,
# non-root, meant to be started read-only with all capabilities dropped (see orchestrator).
FROM python:3.14-slim AS build
WORKDIR /src
COPY infra/docker/.generated/requirements-worker.txt /tmp/requirements.txt
# Third-party dependencies come from the lockfile with hashes; our own packages are installed with
# --no-deps so pip never resolves a workspace sibling (e.g. "labharness") from PyPI.
RUN pip install --no-cache-dir --require-hashes --prefix=/install -r /tmp/requirements.txt
COPY packages/labharness ./packages/labharness
COPY packages/runlog ./packages/runlog
COPY services/worker ./services/worker
RUN pip install --no-cache-dir --no-deps --prefix=/install ./packages/labharness ./packages/runlog ./services/worker
# pysdl2-dll bundles image/audio/font codec libraries the headless emulator never loads (THIRD_PARTY.md):
# remove them if PyBoy still imports without them, otherwise keep everything.
RUN set -e; d=$(find /install -type d -path '*sdl2dll/dll' | head -1); \
    cp -a "$d" /tmp/dll.bak; \
    find "$d" -type f ! -name 'libSDL2-2.0.so*' -delete; \
    if PYTHONPATH=/install/lib/python3.14/site-packages python -c "import pyboy" 2>/dev/null; then echo "pruned $(ls /tmp/dll.bak | wc -l) -> $(ls $d | wc -l) libraries"; \
    else rm -rf "$d" && cp -a /tmp/dll.bak "$d" && echo "pruning broke PyBoy: kept all libraries"; fi

FROM python:3.14-slim
LABEL memorylab.owner="memorylab" memorylab.role="sandbox-worker"
RUN groupadd --gid 10001 worker && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin worker
COPY --from=build /install /usr/local
COPY packages/games/fixture/bundle.json packages/games/fixture/fixture.gb packages/games/fixture/fixture.state packages/games/fixture/fixture.statemap.json /opt/games/fixture/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MEMORYLAB_GAMES_DIR=/opt/games HOME=/tmp
USER 10001:10001
WORKDIR /tmp
ENTRYPOINT ["python", "-m", "worker"]
