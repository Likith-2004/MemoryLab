# Copy to a private file OUTSIDE the repository and fill every value; compose refuses to start with any of these missing.
#
# SECRETS are not here: they are files. Make a private directory (mode 0700) outside the repository, set MEMORYLAB_SECRETS_DIR to it, and put
# one file per secret in it (mode 0400 owned by uid 10001, or 0444 inside that directory), each holding just the value:
#   token_secret  orchestrator_token  accounts_token  blob_signing_secret  log_pepper      (generate with `openssl rand -hex 32`)
#   auth_service_key                                  (GoTrue's service/secret key)
#   service_db_url                                    (service-role Postgres URL: ingest, reaper, accounts)
#   api_db_url                                        (the memorylab_api login URL: the API, never postgres)
# Never commit them; never reuse a value across environments. A secret in an environment variable would be shown by `docker inspect`.
MEMORYLAB_SECRETS_DIR=
# GoTrue: as the services reach it (private network) and the token issuer
MEMORYLAB_AUTH_URL_INTERNAL=
MEMORYLAB_JWKS_URL_INTERNAL=
MEMORYLAB_JWT_ISSUER=
MEMORYLAB_PUBLISHABLE_KEY=
# What a browser sees (https in production)
MEMORYLAB_PUBLIC_API_URL=
MEMORYLAB_SITE_URL=
# The group id of /var/run/docker.sock on the run-worker host (stat -c %g /var/run/docker.sock); only the Docker filter container gets it
DOCKER_GID=
# Optional: UPSTREAM_NETWORK (see the networks section of compose.yaml: an icc-disabled bridge for hosted Supabase), MEMORYLAB_API_BIND, MEMORYLAB_WEB_BIND, MEMORYLAB_MAX_CONCURRENT, MEMORYLAB_SANDBOX_RUNTIME (runsc),
# MEMORYLAB_WEB_TRUSTED_HOPS (read the note in compose.yaml before changing it), MEMORYLAB_INTERNAL_HTTP_HOSTS
