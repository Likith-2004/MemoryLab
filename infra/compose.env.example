# Copy to a private file OUTSIDE the repository and fill every value; compose refuses to start with any of these missing.
# Secrets: generate with `openssl rand -hex 32`. Never commit the filled file; never reuse a value across environments.
MEMORYLAB_TOKEN_SECRET=
MEMORYLAB_ORCHESTRATOR_TOKEN=
MEMORYLAB_ACCOUNTS_TOKEN=
MEMORYLAB_BLOB_SIGNING_SECRET=
MEMORYLAB_LOG_PEPPER=
# Postgres: the service-role login (ingest, reaper, accounts) and the memorylab_api login (the API: RLS applies, never postgres)
MEMORYLAB_SERVICE_DB_URL=
MEMORYLAB_API_DB_URL=
# GoTrue: as the services reach it (private network) and the token issuer
MEMORYLAB_AUTH_URL_INTERNAL=
MEMORYLAB_JWKS_URL_INTERNAL=
MEMORYLAB_JWT_ISSUER=
MEMORYLAB_AUTH_SERVICE_KEY=
MEMORYLAB_PUBLISHABLE_KEY=
# What a browser sees (https in production)
MEMORYLAB_PUBLIC_API_URL=
MEMORYLAB_SITE_URL=
# The group id of /var/run/docker.sock on the run-worker host (stat -c %g /var/run/docker.sock)
DOCKER_GID=
# Optional: SUPABASE_NETWORK, MEMORYLAB_API_BIND, MEMORYLAB_WEB_BIND, MEMORYLAB_MAX_CONCURRENT, MEMORYLAB_SANDBOX_RUNTIME (runsc),
# MEMORYLAB_WEB_TRUSTED_HOPS (read the note in compose.yaml before changing it), MEMORYLAB_INTERNAL_HTTP_HOSTS
